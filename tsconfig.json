{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs-site",
    "research/omnilock/phase2",
    "research/omnilock/phase3",
    "research/omnilock/phase4/change-backup.ts",
    "research/omnilock/phase4/evm-spend.ts",
    "research/omnilock/phase4/joyid-enable.ts",
    "research/omnilock/phase4/joyid-negative.ts",
    "research/omnilock/phase4/joyid-spend.ts",
    "research/omnilock/phase5",
    "research/omnilock/audit-opus-5-5/testnet-adminlist-hijack.ts"
  ]
}
