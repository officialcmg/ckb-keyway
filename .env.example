# Server-only Better Auth and Resend credentials
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://keyway-api-production.up.railway.app
RESEND_API_KEY=
KEYWAY_AUTH_EMAIL_FROM=CKB KeyWay <login@auth.ckbkeyway.dev>
KEYWAY_DASHBOARD_ORIGINS=https://ckbkeyway.dev,https://www.ckbkeyway.dev,http://localhost:3000
# Set only when deployed behind the trusted Railway edge.
KEYWAY_TRUST_PROXY=
NEXT_PUBLIC_KEYWAY_APP_ID=

# Standalone API deployment. Run migrations before starting the production API.
DATABASE_URL=
KEYWAY_ALLOWED_ORIGINS=http://localhost:3000
KEYWAY_RATE_LIMIT_SECRET=
KEYWAY_SIGNING_ALERT_THRESHOLD=20
KEYWAY_SECURITY_ALERT_WEBHOOK_URL=

# Server-only Lit Chipotle runtime credentials
LIT_USAGE_API_KEY=
# Server-only master credential used only to provision PKPs and group membership
LIT_PROVISIONING_API_KEY=
LIT_SIGN_ACTION_CID=QmVvKwLcFTMV4wY5f5w4dQzrX5JWWTr736C8vW3tDinJSq
LIT_ENCRYPT_ACTION_CID=QmdmrTyKWZcxcjHuKpNHDZFvWowPMRLw2zVtsdFt3DkSq6
LIT_DECRYPT_ACTION_CID=QmTzNxwWUCvczgbjhckEoHHJRPnLWA7RY32Kym7YtA2HYM

# Optional managed Fiber beta. Assign distinct nodes to permanent KeyWay account IDs.
KEYWAY_MANAGED_FIBER_NODES={}
# Or use the managed host, which creates one isolated FNN process and data directory per authenticated user.
KEYWAY_MANAGED_FIBER_HOST_URL=
KEYWAY_MANAGED_FIBER_HOST_TOKEN=
KEYWAY_MANAGED_FIBER_RPC_TOKEN=
# Managed host limits. The host also honours KEYWAY_MANAGED_BACKUP_DIR (default /fiber/backups),
# KEYWAY_MANAGED_MAX_BACKUP_BYTES (default 512 MiB), and KEYWAY_MANAGED_BACKUP_GENERATIONS (default 3).
KEYWAY_MANAGED_MAX_NODES=16
KEYWAY_MANAGED_MAX_CHANNELS=5
# Browser-mode encrypted backups: immutable generations retained per user.
KEYWAY_BACKUP_GENERATIONS=3
